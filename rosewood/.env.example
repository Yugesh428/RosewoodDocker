# ─────────────────────────────────────────────────────────────────────────────
# Rosewood Pharmacy — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or any Postgres provider)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# A long, random secret string used to sign JWT tokens
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
AUTH_SECRET="your-nextauth-secret-min-32-chars"

# The base URL of your app (no trailing slash)
# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ── Storage ───────────────────────────────────────────────────────────────────
# "local"  → uploads saved to /public/uploads/ (for development)
# "s3"     → uploads saved to AWS S3 (for production)
STORAGE_PROVIDER="local"

# ── AWS S3 (required only when STORAGE_PROVIDER=s3) ──────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_S3_BASE_URL="https://your-bucket.s3.ap-south-1.amazonaws.com"

# ── App (optional) ────────────────────────────────────────────────────────────
# Used by server components to make internal API calls
# Leave as localhost:3000 for development
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# For Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
# For Outlook/Hotmail: use smtp.office365.com / port 587
# For custom SMTP: fill in your provider's settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Rosewood Pharmacy <your-email@gmail.com>"
